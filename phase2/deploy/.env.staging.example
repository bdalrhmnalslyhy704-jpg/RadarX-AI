# STAGING ONLY — placeholders; never commit real values.
RADARX_ENV=staging
RADARX_STAGING_TEST_PUSH_ENABLED=false
RADARX_HOST=0.0.0.0
RADARX_BACKGROUND_MONITOR_ENABLED=true
RADARX_SYMBOLS=BTCUSDT,ETHUSDT
RADARX_PUSH_PROVIDER=webpush
RADARX_ALLOWED_ORIGINS=https://radarx-staging.example.com
RADARX_PUBLIC_API_ORIGIN=https://radarx-api-staging.example.com
RADARX_DATA_DIR=/var/data/radarx

# Secret values must be injected on the host/secret manager, not stored in Git.
RADARX_AUTH_SECRET=<LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
VAPID_SUBJECT=mailto:<OPERATOR_EMAIL>
VAPID_PUBLIC_KEY=<VAPID_PUBLIC_KEY>
VAPID_PRIVATE_KEY=<VAPID_PRIVATE_KEY>

# Safety: these are fixed by application policy and must remain unchanged.
RADARX_PAPER_TRADING=true
RADARX_REAL_ORDER_EXECUTION=false
RADARX_CONFIDENCE_MODE=UNKNOWN
