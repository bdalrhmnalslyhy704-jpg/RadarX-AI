{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/radarx-sw-5.13.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/radarx-background-client.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/bn/:path*",
      "destination": "https://data-api.binance.vision/api/:path*"
    },
    {
      "source": "/api/bn2/:path*",
      "destination": "https://api.binance.com/api/:path*"
    },
    {
      "source": "/api/bn3/:path*",
      "destination": "https://api-gcp.binance.com/api/:path*"
    }
  ]
}
