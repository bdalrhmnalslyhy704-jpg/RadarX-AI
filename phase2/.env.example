# Real values must be injected by a deployment secret manager or shell.
# Never commit an .env file containing secrets.
RADARX_ENV=staging
RADARX_STAGING_TEST_PUSH_ENABLED=false
RADARX_HOST=127.0.0.1
RADARX_PORT=8787
RADARX_SYMBOLS=BTCUSDT,ETHUSDT
RADARX_PUSH_PROVIDER=none
RADARX_AUTH_SECRET=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RADARX_ALLOWED_ORIGINS=
RADARX_DATA_DIR=./.radarx-data
