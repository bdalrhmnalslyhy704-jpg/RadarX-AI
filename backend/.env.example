# Never commit real credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance key should have Read + Spot trading only.
# Disable withdrawals, margin, futures and portfolio-margin permissions on the key.

# Separate RadarX control token protects signed account/order endpoints.
RADARX_CONTROL_TOKEN=replace-with-a-long-random-secret
RADARX_REQUIRE_CONTROL_TOKEN=true
BINANCE_RECV_WINDOW_MS=5000

# Keep these OFF until the backend is fully tested in paper mode.
RADARX_ALLOW_LIVE_TRADING=false
RADARX_AUTO_EXECUTION=false
RADARX_ALLOW_FUTURES=false

RADARX_HOST=0.0.0.0
RADARX_PORT=8000
RADARX_SCAN_INTERVAL_SEC=8
RADARX_TICKER_STALE_SEC=8
RADARX_MIN_QUOTE_VOLUME=750000
RADARX_STAGE1_LIMIT=80
RADARX_STAGE2_LIMIT=30
RADARX_ALERT_SCORE=82
RADARX_ALERT_TRAP_MAX=35
RADARX_MAX_CONCURRENT_REST=12
RADARX_REST_TIMEOUT_SEC=5.5
RADARX_RISK_PCT=0.5
RADARX_MAX_NOTIONAL_USDT=50
RADARX_DAILY_LOSS_PCT=2

# Optional regional public-data fallback.
RADARX_CLOUD_RELAY_URL=https://radar-x-ai.vercel.app/api/binance
RADARX_CORS_ORIGINS=*
