# Real values must be injected by a deployment secret manager or shell.
# Never commit an .env file containing secrets.
RADARX_ENV=staging
RADARX_STAGING_TEST_PUSH_ENABLED=false
RADARX_HOST=127.0.0.1
RADARX_PORT=8787
RADARX_SYMBOLS=BTCUSDT,ETHUSDT
RADARX_PUSH_PROVIDER=none
RADARX_AUTH_SECRET=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RADARX_ALLOWED_ORIGINS=
RADARX_DATA_DIR=./.radarx-data

# Radar 3: cross-market rotation/lag detector
RADARX_ROTATION_RADAR_POLL_MS=30000
RADARX_ROTATION_RADAR_UNIVERSE_REFRESH_MS=300000
RADARX_ROTATION_RADAR_MIN_QUOTE_VOLUME_24H=750000
RADARX_ROTATION_RADAR_BATCH=7
RADARX_ROTATION_RADAR_TOP_LAGGERS=3
RADARX_ROTATION_RADAR_MAX_24H_MOVE_PCT=8
RADARX_ROTATION_RADAR_ALERT_COOLDOWN_MS=600000
RADARX_ROTATION_RADAR_MIN_SCORE=78
RADARX_ROTATION_RADAR_MIN_CONFIRMATIONS=4
