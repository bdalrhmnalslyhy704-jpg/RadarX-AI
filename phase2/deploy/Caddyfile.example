# Provider-neutral Caddy configuration for RadarX.
# Replace the hostname only when a real deployment is ready.
# Public edge: TCP 80/443.
# RadarX Node: PORT supplied through /etc/radarx/radarx.env.
# The example below assumes PORT=8787 in that environment file.
#
# Do not expose 8787 (or the selected PORT) through the public firewall.
# Caddy is the only public HTTP/HTTPS entry point.

radarx.example.com {
    encode gzip zstd

    # PWA static files. /phase1/app.html -> /opt/radarx/phase1/app.html
    @pwa path /phase1/*
    handle @pwa {
        root * /opt/radarx
        file_server
    }

    # Optional convenience redirect.
    redir / /phase1/ 308

    # API, /healthz, /readyz, and WebSocket traffic all use the same
    # backend service port. reverse_proxy supports WebSocket upgrade.
    reverse_proxy 127.0.0.1:8787
}
